#include <iostream>
#include <iomanip>
using namespace std;

int main() {

    double M[12][12];
    int in1;
    char in2;
    double sum=0;
    double avg;

    cin>>in1;
    cin>>in2;

    for(int i=0; i<12; i++){
        for(int j=0; j<12; j++){
            cin>>M[i][j];
        }
    }

    for(int i=0; i<12; i++){
        sum+=M[in1][i];
    }

    if(in2=='S'){
        cout<<fixed<<setprecision(1)<<sum<<"\n";
    }
    else if(in2=='M'){
        avg=sum/12;
        cout<<fixed<<setprecision(1)<<avg<<"\n";
    }

    return 0;
}
